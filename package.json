{
  "name": "livelify-webapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite --mode development --host",
    "start:qa": "vite --mode qa",
    "start:prod": "vite preview --mode production",
    "start:debug": "vite --mode development --debug",
    "start:debug:qa": "vite --mode qa --debug",
    "start:debug:prod": "vite preview --mode production --debug",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:qa": "tsc -b && vite build --mode qa",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.17",
    "i18next": "25.6.3",
    "i18next-browser-languagedetector": "8.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "16.3.5",
    "react-router-dom": "7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.22",
    "cssnano": "7.1.2",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.2.4"
  }
}
