{
  "name": "livelify-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start:dev": "vite --mode development --host",
    "start:qa": "vite --mode qa",
    "start:prod": "vite preview --mode production",
    "start:debug": "vite --mode development --debug",
    "start:debug:qa": "vite --mode qa --debug",
    "start:debug:prod": "vite preview --mode production --debug",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "build:qa": "tsc -b && vite build --mode qa",
    "build:prod": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/node": "24.6.2",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "cssnano": "7.1.1",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "6.1.1",
    "eslint-plugin-react-refresh": "0.4.23",
    "globals": "16.4.0",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.1.9"
  }
}
